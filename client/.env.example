# AIサーバ接続先。未設定なら vite の /ai プロキシ経由で docker の server:8787 へ。
# 'mock' にするとバックエンド不要のモック応答になる。
# VITE_AI_BASE_URL=/ai
# VITE_AI_BASE_URL=mock
# VITE_AI_BASE_URL=http://localhost:8787

# PeerJS ブローカー。未設定なら PeerJS クラウド(0.peerjs.com)を使用。
# 自前ブローカーを立てる場合:
# VITE_PEERJS_HOST=localhost
# VITE_PEERJS_PORT=9000
# VITE_PEERJS_SECURE=false
